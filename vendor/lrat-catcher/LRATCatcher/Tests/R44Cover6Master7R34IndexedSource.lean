def d7NewPayloadCharAt (index : Nat) : Char :=
  String.Pos.Raw.get! d7NewCubePayload ⟨index⟩

def d7DecodePackedFrom (offset item : Nat) : Nat :=
  (List.range packedCubeDigits).foldl (fun value digit =>
    value + alphabetValue
        (d7NewPayloadCharAt
          (offset + item * packedCubeDigits + digit)) *
      2 ^ (6 * digit)) 0

def d7DecodeCubeFrom (offset item : Nat) : Cube :=
  let packed := d7DecodePackedFrom offset item
  (packed % (2 ^ localEdgeBits), packed / (2 ^ localEdgeBits))

def d7NewBlockCubeAt (index : Nat) : Cube :=
  d7DecodeCubeFrom d7NewBlockPayloadOffset index

def d7NewLocalCubeAt (index : Nat) : Cube :=
  d7DecodeCubeFrom d7NewLocalPayloadOffset index

def d7NewCatalogueFingerprint (offset count : Nat) : UInt64 :=
  (List.range count).foldl (fun hash item =>
    (hash ^^^ UInt64.ofNat (d7DecodePackedFrom offset item)) *
      1099511628211) 14695981039346656037

