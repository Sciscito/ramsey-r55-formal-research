/-! ## Exact F7 clause arithmetic -/

def d7BaseClauseCount : Nat := 699
def d7BlockClauseCount : Nat := 4127760
def d7LocalClauseCount : Nat := 183960
def d7BlockClauseStart : Nat := d7BaseClauseCount
def d7LocalClauseStart : Nat := d7BaseClauseCount + d7BlockClauseCount
def f7ClauseCount : Nat :=
  d7BaseClauseCount + d7BlockClauseCount + d7LocalClauseCount
def r34UnitClauseCount : Nat := 21
def branchClauseCount : Nat := f7ClauseCount + r34UnitClauseCount

def d7BlockCatalogueCount : Nat -> Nat
  | 3 => 15480
  | 4 => 15480
  | 5 => 10200
  | 6 => 4680
  | 7 => 2520
  | _ => 0

def d7LocalCatalogueCount : Nat -> Nat
  | 2 => 360
  | 3 => 540
  | 4 => 360
  | 5 => 300
  | _ => 0

def d7NeighborCount (items : List Nat) : Nat :=
  items.foldl (fun count vertex => if vertex ≤ 7 then count + 1 else count) 0

def d7BlockLocation (index : Nat) : Option (List Nat × Nat) :=
  locateWeighted (fun item => d7BlockCatalogueCount (d7NeighborCount item))
    (combinations 1 11 7) index

def d7LocalLocation (index : Nat) : Option (List Nat × Nat) :=
  locateWeighted (fun item => d7LocalCatalogueCount (d7NeighborCount item))
    (combinations 1 11 6) index

def d7BlockCubeAt (neighbors index : Nat) : Cube :=
  if neighbors = 3 then d7NewBlockCubeAt index
  else blockCubeAt neighbors index

def d7LocalCubeAt (neighbors index : Nat) : Cube :=
  if neighbors = 2 then d7NewLocalCubeAt index
  else localCubeAt neighbors index

def d7BaseClause (index : Nat) : List Int :=
  if index < 660 then
    baseClause index
  else if index < 695 then
    let item := (combinations 1 7 3).getD (index - 660) []
    signedVariables false (pythonPairVariables item)
  else
    let item := (combinations 8 4 3).getD (index - 695) []
    signedVariables true (pythonPairVariables item)

def d7BlockClause (index : Nat) : List Int :=
  match d7BlockLocation index with
  | some (item, cubeIndex) =>
      instantiate (d7BlockCubeAt (d7NeighborCount item) cubeIndex)
        (subsetVariables item)
  | none => []

def d7LocalClause (index : Nat) : List Int :=
  match d7LocalLocation index with
  | some (item, cubeIndex) =>
      instantiate (d7LocalCubeAt (d7NeighborCount item) cubeIndex)
        (subsetVariables item)
  | none => []

def f7ClauseDimacs (index : Nat) : List Int :=
  if index < d7BlockClauseStart then
    d7BaseClause index
  else if index < d7LocalClauseStart then
    d7BlockClause (index - d7BlockClauseStart)
  else
    d7LocalClause (index - d7LocalClauseStart)

def f7Source : IndexedCNFSource Nat where
  clauseCount := f7ClauseCount
  clauseAt index := dimacsClause (f7ClauseDimacs index.val)

def branchUnitLiteral (catalogueIndex : Fin 9) (position : Nat) : Int :=
  (d7RepresentativeUnits
    (r34Catalogue7Representative catalogueIndex)).getD position 0

def branchClauseDimacs (catalogueIndex : Fin 9)
    (index : Nat) : List Int :=
  if index < f7ClauseCount then f7ClauseDimacs index
  else [branchUnitLiteral catalogueIndex (index - f7ClauseCount)]

/-- F7 followed by the 21 units of catalogue representative
`catalogueIndex`. -/
def branchSource (catalogueIndex : Fin 9) : IndexedCNFSource Nat where
  clauseCount := branchClauseCount
  clauseAt index := dimacsClause
    (branchClauseDimacs catalogueIndex index.val)

/-- The incremental-CNF branch order differs from Lean's catalogue order by
the certified swap `[1,0,2,3,4,5,6,7,8]`. -/
def iCNFBranchSource (iCNFIndex : Fin 9) : IndexedCNFSource Nat :=
  branchSource (r34IndexSwap iCNFIndex)

/-! ## Lightweight exactness checks -/

theorem d7BlockWeightedClauseCount :
    weightedCount
      (fun item => d7BlockCatalogueCount (d7NeighborCount item))
      (combinations 1 11 7) = d7BlockClauseCount := by
  native_decide

theorem d7LocalWeightedClauseCount :
    weightedCount
      (fun item => d7LocalCatalogueCount (d7NeighborCount item))
      (combinations 1 11 6) = d7LocalClauseCount := by
  native_decide

theorem f7Source_clauseCount : f7Source.clauseCount = 4312419 := rfl

theorem branchSource_clauseCount (catalogueIndex : Fin 9) :
    (branchSource catalogueIndex).clauseCount = 4312440 := rfl

theorem branchSource_clauseAt_f7
    (catalogueIndex : Fin 9) (position : Fin f7ClauseCount) :
    (branchSource catalogueIndex).clauseAt
        ⟨position.val, by
          change position.val < branchClauseCount
          dsimp [branchClauseCount, f7ClauseCount, r34UnitClauseCount]
          omega⟩ =
      f7Source.clauseAt position := by
  simp [branchSource, branchClauseDimacs, f7Source, position.isLt]

theorem branchSource_clauseAt_unit
    (catalogueIndex : Fin 9) (position : Fin 21) :
    (branchSource catalogueIndex).clauseAt
        ⟨f7ClauseCount + position.val, by
          change f7ClauseCount + position.val < branchClauseCount
          dsimp [branchClauseCount, f7ClauseCount, r34UnitClauseCount]
          omega⟩ =
      dimacsClause [branchUnitLiteral catalogueIndex position.val] := by
  have hnot : ¬ f7ClauseCount + position.val < f7ClauseCount := by omega
  simp [branchSource, branchClauseDimacs, hnot]

theorem iCNFBranchSource_eq_catalogueBranch
    (iCNFIndex : Fin 9) :
    iCNFBranchSource iCNFIndex =
      branchSource (r34IndexSwap iCNFIndex) := rfl

