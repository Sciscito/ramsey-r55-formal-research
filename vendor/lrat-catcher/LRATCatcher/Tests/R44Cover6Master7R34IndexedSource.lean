/-! ## Structural satisfaction of the appended unit tail -/

theorem branchSource_unitClause_eval_true
    (coloring : Nat -> Bool) (catalogueIndex : Fin 9)
    (sourceToRepresentative : LRATCatcher.Tests.R35.FinPermutation 7)
    (hmap : D7R34FixedIsoData coloring catalogueIndex
      sourceToRepresentative) (position : Fin 21) :
    CNF.Clause.eval
        (d7R34RelabeledColoring coloring sourceToRepresentative)
        ((branchSource catalogueIndex).clauseAt
          ⟨f7ClauseCount + position.val, by
            change f7ClauseCount + position.val < branchClauseCount
            dsimp [branchClauseCount, f7ClauseCount, r34UnitClauseCount]
            omega⟩) = true := by
  let units := d7RepresentativeUnits
    (r34Catalogue7Representative catalogueIndex)
  have hlength : units.length = 21 := by
    simpa [units] using d7RepresentativeUnits_length
      (r34Catalogue7Representative catalogueIndex)
  have hposition : position.val < units.length := by
    rw [hlength]
    exact position.isLt
  have hmember : units.getD position.val 0 ∈ units := by
    rw [← List.getElem_eq_getD
      (l := units) (i := position.val) (h := hposition) 0]
    exact List.getElem_mem hposition
  have hsatisfied := d7R34Relabeled_representativeUnitsSatisfied
    coloring catalogueIndex sourceToRepresentative hmap
    (units.getD position.val 0) hmember
  rw [branchSource_clauseAt_unit]
  simpa [branchUnitLiteral, units, dimacsClause,
    dimacsUnitSatisfied] using hsatisfied

theorem degreeSeven_has_r34BranchUnitTail
    {coloring : Nat -> Bool}
    (hfree : LRATCatcher.Ramsey.isRamseyFree 12 4 4 coloring)
    (hdegree :
      LRATCatcher.Tests.R44OrderTwelveTwoCenterCases.positiveRootDegree
        coloring = 7) :
    ∃ catalogueIndex : Fin 9,
      ∃ sourceToRepresentative : LRATCatcher.Tests.R35.FinPermutation 7,
        D7R34FixedIsoData coloring catalogueIndex
            sourceToRepresentative ∧
        LRATCatcher.Ramsey.isRamseyFree 12 4 4
          (d7R34RelabeledColoring coloring sourceToRepresentative) ∧
        ∀ position : Fin 21,
          CNF.Clause.eval
              (d7R34RelabeledColoring coloring sourceToRepresentative)
              ((branchSource catalogueIndex).clauseAt
                ⟨f7ClauseCount + position.val, by
                  change f7ClauseCount + position.val < branchClauseCount
                  dsimp [branchClauseCount, f7ClauseCount,
                    r34UnitClauseCount]
                  omega⟩) = true := by
  obtain ⟨catalogueIndex, sourceToRepresentative, hmap, hfree',
      _hrootPositive, _hrootRight, _hedges, _hunits⟩ :=
    degreeSeven_has_r34RepresentativeRelabeling hfree hdegree
  exact ⟨catalogueIndex, sourceToRepresentative, hmap, hfree',
    branchSource_unitClause_eval_true coloring catalogueIndex
      sourceToRepresentative hmap⟩

