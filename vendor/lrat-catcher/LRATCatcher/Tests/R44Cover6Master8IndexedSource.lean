import LRATCatcher.Reflect
import LRATCatcher.Tests.R44Cover6Master8CoreBridge

/-!
  # Lazy indexed source for the cover6 degree-eight master formula

  `master8Source` reconstructs the 3,367,459-clause stream without building
  that array.  Its `clauseAt` splits into the 717 base clauses, weighted K7
  blocks, weighted K6 blocks, and the 22 Master8 clauses.  Weighted locations
  are unranked in Python `itertools.combinations` order.

  The conditioned cube catalogues are the data-import boundary.  They were
  emitted by `exact_replay_cover6_d8.py`, restricted to the neighbour counts
  reachable in K12, and packed into seven ASCII digits per cube.  Their raw
  payload SHA-256 values are respectively
  `98B76E3BA2E3A8AF897C44572040F07690D1D5A9050B78B8AF28703FC77D01D1`
  and
  `E2DCE6964D99B6F94D0F12A35E12BC5B53677F60215CA44F23CDE0F290FC5BBB`.
  Lean checks both complete decoded payloads below with independent lengths
  and 64-bit FNV-style word fingerprints; it does not rederive them from the
  six cube representatives in this module.

  The LRAT dependency core needs only F8, seven sorting clauses, and `-15`.
  `normalizedSource` is exactly this smaller parent formula.  The final
  theorem checks all 6,152 selected clauses against the tracked core CNF,
  replays its LRAT, and transfers UNSAT through the indexed-source bridge.
-/

namespace LRATCatcher.Tests.R44Cover6Master8IndexedSource

open Std.Sat
open LRATCatcher.Tests.R44Cover6Master8CoreBridge

set_option maxRecDepth 100000

abbrev Cube := Nat × Nat

def pythonCombinations {Alpha : Type} : List Alpha → Nat → List (List Alpha)
  | _, 0 => [[]]
  | [], _ + 1 => []
  | head :: tail, size + 1 =>
      (pythonCombinations tail size).map (head :: .) ++
        pythonCombinations tail (size + 1)

def vertices (first count : Nat) : List Nat :=
  (List.range count).map fun offset => first + offset

def combinations (first count size : Nat) : List (List Nat) :=
  pythonCombinations (vertices first count) size

def neighborCount (items : List Nat) : Nat :=
  items.foldl (fun count vertex => if vertex ≤ 8 then count + 1 else count) 0

def globalEdge (left right : Nat) : Nat :=
  let small := min left right
  let large := max left right
  small * (23 - small) / 2 + large - small

def pythonPairVariables (items : List Nat) : List Nat :=
  (pythonCombinations items 2).filterMap fun pair =>
    match pair with
    | [left, right] => some (globalEdge left right)
    | _ => none

def subsetVariables (items : List Nat) : List Nat :=
  (List.range items.length).drop 1 |>.flatMap fun right =>
    (List.range right).map fun left =>
      globalEdge (items.getD left 0) (items.getD right 0)

def positive (dimacsVariable : Nat) : Int := Int.ofNat dimacsVariable
def negative (dimacsVariable : Nat) : Int := -(Int.ofNat dimacsVariable)

def signedVariables (isPositive : Bool) (variables : List Nat) : List Int :=
  variables.map fun dimacsVariable =>
    if isPositive then positive dimacsVariable else negative dimacsVariable

def baseClause (index : Nat) : List Int :=
  if index < 660 then
    let item := (combinations 1 11 4).getD (index / 2) []
    signedVariables (index % 2 = 1) (pythonPairVariables item)
  else if index < 716 then
    let item := (combinations 1 8 3).getD (index - 660) []
    signedVariables false (pythonPairVariables item)
  else
    signedVariables true (pythonPairVariables [9, 10, 11])

def blockCatalogueCount : Nat → Nat
  | 4 => 15480
  | 5 => 10200
  | 6 => 4680
  | 7 => 2520
  | _ => 0

def localCatalogueCount : Nat → Nat
  | 3 => 540
  | 4 => 360
  | 5 => 300
  | _ => 0

def locateWeighted (width : List Nat → Nat) :
    List (List Nat) → Nat → Option (List Nat × Nat)
  | [], _ => none
  | item :: rest, index =>
      if index < width item then some (item, index)
      else locateWeighted width rest (index - width item)

def blockLocation (index : Nat) : Option (List Nat × Nat) :=
  locateWeighted (fun item => blockCatalogueCount (neighborCount item))
    (combinations 1 11 7) index

def localLocation (index : Nat) : Option (List Nat × Nat) :=
  locateWeighted (fun item => localCatalogueCount (neighborCount item))
    (combinations 1 11 6) index

def weightedCount (width : List Nat → Nat) (items : List (List Nat)) : Nat :=
  items.foldl (fun count item => count + width item) 0

def dataChunkSize : Nat := 4060
def packedCubeDigits : Nat := 7
def localEdgeBits : Nat := 21

def alphabetValue (character : Char) : Nat :=
  let code := character.toNat
  if '0'.toNat ≤ code && code ≤ '9'.toNat then code - '0'.toNat
  else if 'A'.toNat ≤ code && code ≤ 'Z'.toNat then code - 'A'.toNat + 10
  else if 'a'.toNat ≤ code && code ≤ 'z'.toNat then code - 'a'.toNat + 36
  else if character = '-' then 62
  else if character = '_' then 63
  else 0

def dataCharAt (chunks : Array String) (index : Nat) : Char :=
  let chunk := chunks.getD (index / dataChunkSize) ""
  String.Pos.Raw.get! chunk ⟨index % dataChunkSize⟩

def decodePacked (chunks : Array String) (item : Nat) : Nat :=
  (List.range packedCubeDigits).foldl (fun value digit =>
    value + alphabetValue (dataCharAt chunks (item * packedCubeDigits + digit)) *
      2 ^ (6 * digit)) 0

def decodeCube (chunks : Array String) (item : Nat) : Cube :=
  let packed := decodePacked chunks item
  (packed % (2 ^ localEdgeBits), packed / (2 ^ localEdgeBits))

def dataLength (chunks : Array String) : Nat :=
  chunks.foldl (fun total chunk => total + chunk.utf8ByteSize) 0

def catalogueFingerprint (chunks : Array String) (count : Nat) : UInt64 :=
  (List.range count).foldl (fun hash item =>
    (hash ^^^ UInt64.ofNat (decodePacked chunks item)) * 1099511628211)
    14695981039346656037

