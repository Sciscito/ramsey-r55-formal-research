def blockCatalogueOffset : Nat → Nat
  | 4 => 0
  | 5 => 15480
  | 6 => 25680
  | 7 => 30360
  | _ => 0

def localCatalogueOffset : Nat → Nat
  | 3 => 0
  | 4 => 540
  | 5 => 900
  | _ => 0

def blockCubeAt (neighbors index : Nat) : Cube :=
  decodeCube blockCubeDataChunks (blockCatalogueOffset neighbors + index)

def localCubeAt (neighbors index : Nat) : Cube :=
  decodeCube localCubeDataChunks (localCatalogueOffset neighbors + index)

def bit (value position : Nat) : Bool :=
  value / 2 ^ position % 2 = 1

def instantiate (cube : Cube) (variables : List Nat) : List Int :=
  (List.range variables.length).filterMap fun position =>
    if bit cube.2 position then
      let dimacsVariable := variables.getD position 0
      some (if bit cube.1 position then negative dimacsVariable else positive dimacsVariable)
    else
      none

def blockClause (index : Nat) : List Int :=
  match blockLocation index with
  | some (item, cubeIndex) =>
      instantiate (blockCubeAt (neighborCount item) cubeIndex) (subsetVariables item)
  | none => []

def localClause (index : Nat) : List Int :=
  match localLocation index with
  | some (item, cubeIndex) =>
      instantiate (localCubeAt (neighborCount item) cubeIndex) (subsetVariables item)
  | none => []

def rootUnits : List (List Int) :=
  (List.range 11).map fun offset =>
    let dimacsVariable := offset + 1
    [if dimacsVariable ≤ 8 then positive dimacsVariable else negative dimacsVariable]

def prefixClauses : List (List Int) := [
  [12, -13], [13, -14], [14, -15], [15, -16],
