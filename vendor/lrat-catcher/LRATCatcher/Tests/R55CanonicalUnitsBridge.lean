import LRATCatcher.Tests.R55CommonNeighborhoodBridge

/-!
  Semantic bridge for the canonical unit clauses generated by
  `ramsey.py fixed_neighborhood_clauses(43, 20)` and
  `fixed_anchor_codegree_clauses(43, 20, 10)`.

  Python/DIMACS variables are one-based, whereas `Ramsey.edgeVar` and a Lean
  coloring are zero-based.  The definitions below make the `+1` / `-1`
  conversion explicit and then prove that satisfaction of the 42 root units
  and 19 anchor units yields exactly the two canonical lists consumed by
  `LocalD20C10Witness.ofCanonicalBranch`.
-/

namespace LRATCatcher.Tests.R55

open Std.Sat
open LRATCatcher.Ramsey

open DegreeTwentyCodegreeTenNeighborhood.ExactLists

namespace CanonicalUnits

/-- One-based DIMACS variable corresponding to Lean's zero-based edge index. -/
def dimacsEdgeVar (order left right : Nat) : Nat :=
  edgeVar order left right + 1

/-- The positive DIMACS literal for an edge. -/
def positiveEdgeLiteral (order left right : Nat) : Int :=
  Int.ofNat (dimacsEdgeVar order left right)

/-- The negative DIMACS literal for an edge. -/
def negativeEdgeLiteral (order left right : Nat) : Int :=
  -Int.ofNat (dimacsEdgeVar order left right)

/-- Semantic satisfaction of a one-literal DIMACS clause. -/
def dimacsUnitSatisfied (coloring : Nat → Bool) (literal : Int) : Prop :=
  CNF.Clause.eval coloring [LRATCatcher.dimacsLit literal] = true

/-- Parsing a positive one-based edge variable recovers the zero-based Lean
edge index and positive polarity. -/
theorem dimacsLit_positiveEdgeLiteral (order left right : Nat) :
    LRATCatcher.dimacsLit (positiveEdgeLiteral order left right) =
      (edgeVar order left right, true) := by
  unfold positiveEdgeLiteral dimacsEdgeVar LRATCatcher.dimacsLit
  change
    (edgeVar order left right + 1 - 1,
      decide (0 < Int.ofNat (edgeVar order left right + 1))) =
      (edgeVar order left right, true)
  simp

/-- Parsing a negative one-based edge variable recovers the zero-based Lean
edge index and negative polarity. -/
theorem dimacsLit_negativeEdgeLiteral (order left right : Nat) :
    LRATCatcher.dimacsLit (negativeEdgeLiteral order left right) =
      (edgeVar order left right, false) := by
  unfold negativeEdgeLiteral dimacsEdgeVar LRATCatcher.dimacsLit
  change
    (edgeVar order left right + 1 - 1,
      decide (0 < -Int.ofNat (edgeVar order left right + 1))) =
      (edgeVar order left right, false)
  have hpositive :
      (0 : Int) < Int.ofNat (edgeVar order left right + 1) :=
    Int.natCast_pos.mpr (by omega)
  have hnotPositive :
      ¬(0 : Int) < -Int.ofNat (edgeVar order left right + 1) := by
    omega
  have hnonnegative :
      (0 : Int) ≤ Int.ofNat (edgeVar order left right) :=
    Int.natCast_nonneg _
  simp
  omega

@[simp] theorem positiveEdgeUnit_iff (coloring : Nat → Bool)
    (order left right : Nat) :
    dimacsUnitSatisfied coloring (positiveEdgeLiteral order left right) ↔
      coloring (edgeVar order left right) = true := by
  simp [dimacsUnitSatisfied, dimacsLit_positiveEdgeLiteral, CNF.Clause.eval]

@[simp] theorem negativeEdgeUnit_iff (coloring : Nat → Bool)
    (order left right : Nat) :
    dimacsUnitSatisfied coloring (negativeEdgeLiteral order left right) ↔
      coloring (edgeVar order left right) = false := by
  simp [dimacsUnitSatisfied, dimacsLit_negativeEdgeLiteral, CNF.Clause.eval]

/-- Literal emitted by `fixed_neighborhood_clauses(43, 20)` for `vertex`. -/
def canonicalRootUnit (vertex : Nat) : Int :=
  if vertex ≤ 20 then
    positiveEdgeLiteral 43 0 vertex
  else
    negativeEdgeLiteral 43 0 vertex

/-- Exactly the 42 root-neighbourhood units, for vertices `1, ..., 42`. -/
def canonicalRootUnits : List Int :=
  (List.range' 1 42).map canonicalRootUnit

/-- Literal emitted by `fixed_anchor_codegree_clauses(43, 20, 10)` for
`vertex`. -/
def canonicalAnchorUnit (vertex : Nat) : Int :=
  if vertex ≤ 11 then
    positiveEdgeLiteral 43 1 vertex
  else
    negativeEdgeLiteral 43 1 vertex

/-- Exactly the 19 anchor-codegree units, for vertices `2, ..., 20`. -/
def canonicalAnchorUnits : List Int :=
  (List.range' 2 19).map canonicalAnchorUnit

/-- Every unit in a generated unit list is satisfied by the coloring. -/
def AllUnitsSatisfied (coloring : Nat → Bool) (units : List Int) : Prop :=
  ∀ literal, literal ∈ units → dimacsUnitSatisfied coloring literal

/-- The complete semantic assumption contributed by the two Python unit
generators in the canonical `d=20,c=10` branch. -/
structure CanonicalD20C10Units (coloring : Nat → Bool) : Prop where
  root : AllUnitsSatisfied coloring canonicalRootUnits
  anchor : AllUnitsSatisfied coloring canonicalAnchorUnits

theorem CanonicalD20C10Units.root_unit {coloring : Nat → Bool}
    (units : CanonicalD20C10Units coloring) (vertex : Nat)
    (hlower : 1 ≤ vertex) (hupper : vertex < 43) :
    dimacsUnitSatisfied coloring (canonicalRootUnit vertex) := by
  apply units.root
  apply List.mem_map.mpr
  refine ⟨vertex, ?_, rfl⟩
  apply List.mem_range'.mpr
  exact ⟨vertex - 1, by omega, by omega⟩

theorem CanonicalD20C10Units.anchor_unit {coloring : Nat → Bool}
    (units : CanonicalD20C10Units coloring) (vertex : Nat)
    (hlower : 2 ≤ vertex) (hupper : vertex ≤ 20) :
    dimacsUnitSatisfied coloring (canonicalAnchorUnit vertex) := by
  apply units.anchor
  apply List.mem_map.mpr
  refine ⟨vertex, ?_, rfl⟩
  apply List.mem_range'.mpr
  exact ⟨vertex - 2, by omega, by omega⟩

/-- The canonical root units force precisely vertices `1, ..., 20` to be
red neighbours of vertex `0`. -/
theorem rootRedNeighbors_eq_range {coloring : Nat → Bool}
    (units : CanonicalD20C10Units coloring) :
    rootRedNeighbors coloring 0 = List.range' 1 20 := by
  unfold rootRedNeighbors
  calc
    (List.range 43).filter (fun vertex => ramseyEdge 43 coloring 0 vertex) =
        (List.range 43).filter (fun vertex => decide (1 ≤ vertex ∧ vertex ≤ 20)) := by
      apply List.filter_congr
      intro vertex hvertex
      have hupper : vertex < 43 := List.mem_range.mp hvertex
      by_cases hzero : vertex = 0
      · subst vertex
        simp [ramseyEdge]
      · have hlower : 1 ≤ vertex := Nat.one_le_iff_ne_zero.mpr hzero
        have hpos : 0 < vertex := hlower
        have hunit := units.root_unit vertex hlower hupper
        by_cases hred : vertex ≤ 20
        · have hcolor : coloring (edgeVar 43 0 vertex) = true := by
            exact (positiveEdgeUnit_iff coloring 43 0 vertex).mp
              (by simpa [canonicalRootUnit, hred] using hunit)
          simp [ramseyEdge, hpos, hlower, hred, hcolor]
        · have hcolor : coloring (edgeVar 43 0 vertex) = false := by
            exact (negativeEdgeUnit_iff coloring 43 0 vertex).mp
              (by simpa [canonicalRootUnit, hred] using hunit)
          simp [ramseyEdge, hpos, hlower, hred, hcolor]
    _ = List.range' 1 20 := by decide

/-- After the root units are applied, the anchor units force precisely
vertices `2, ..., 11` to be common red neighbours of vertices `0` and `1`. -/
theorem rootAnchorCommonNeighbors_eq_range {coloring : Nat → Bool}
    (units : CanonicalD20C10Units coloring) :
    rootAnchorCommonNeighbors coloring 0 1 = List.range' 2 10 := by
  unfold rootAnchorCommonNeighbors
  rw [rootRedNeighbors_eq_range units]
  calc
    (List.range' 1 20).filter (fun vertex => ramseyEdge 43 coloring 1 vertex) =
        (List.range' 1 20).filter (fun vertex => decide (2 ≤ vertex ∧ vertex ≤ 11)) := by
      apply List.filter_congr
      intro vertex hvertex
      have hrange : 1 ≤ vertex ∧ vertex < 21 := by
        obtain ⟨offset, hoffset, hequal⟩ := List.mem_range'.mp hvertex
        omega
      have hlowerOne : 1 ≤ vertex := hrange.1
      have hupper : vertex ≤ 20 := by omega
      by_cases hone : vertex = 1
      · subst vertex
        simp [ramseyEdge]
      · have hlower : 2 ≤ vertex := by omega
        have hpos : 1 < vertex := hlower
        have hunit := units.anchor_unit vertex hlower hupper
        by_cases hred : vertex ≤ 11
        · have hcolor : coloring (edgeVar 43 1 vertex) = true := by
            exact (positiveEdgeUnit_iff coloring 43 1 vertex).mp
              (by simpa [canonicalAnchorUnit, hred] using hunit)
          simp [ramseyEdge, hpos, hlower, hred, hcolor]
        · have hcolor : coloring (edgeVar 43 1 vertex) = false := by
            exact (negativeEdgeUnit_iff coloring 43 1 vertex).mp
              (by simpa [canonicalAnchorUnit, hred] using hunit)
          simp [ramseyEdge, hpos, hred, hcolor]
    _ = List.range' 2 10 := by decide

/-- Direct construction of the local semantic witness from the canonical
DIMACS units. -/
def CanonicalD20C10Units.toLocalWitness {coloring : Nat → Bool}
    (units : CanonicalD20C10Units coloring) :
    LocalD20C10Witness coloring :=
  LocalD20C10Witness.ofCanonicalBranch
    (rootRedNeighbors_eq_range units)
    (rootAnchorCommonNeighbors_eq_range units)

/-- End-to-end semantic entry point: the canonical DIMACS units construct the
exact common-neighbour graph consumed by the certified order-ten catalogue. -/
theorem CanonicalD20C10Units.covered_by_orderTenCatalogue
    {coloring : Nat → Bool}
    (hfree : isRamseyFree 43 5 5 coloring)
    (units : CanonicalD20C10Units coloring) :
    ∃ representative,
      representative ∈ LRATCatcher.Tests.R35.catalogues.getD 10 [] ∧
      LRATCatcher.Tests.R35.GraphIsomorphicFin
        (inducedGraph units.toLocalWitness.toExactLists) representative := by
  exact LocalD20C10Witness.covered_by_orderTenCatalogue
    hfree units.toLocalWitness

end CanonicalUnits

end LRATCatcher.Tests.R55
